# Banco de dados local (SQLite). No SaaS vira uma URL Postgres.
# Caminho relativo ao arquivo packages/db/prisma/schema.prisma
DATABASE_URL="file:../../../storage/docupulse.db"

# Pasta onde a mídia gerada é gravada (relativa à raiz do monorepo)
# Onde ficam vídeos, áudios e projetos. Aponte para a pasta/disco que preferir (caminho absoluto).
STORAGE_DIR="./storage"

# Provedores de IA e mídia (Sprint 1+). Deixe vazio por enquanto.
GEMINI_API_KEY=""            # chave gratuita (texto e voz)
GEMINI_IMAGE_API_KEY=""      # chave com faturamento (imagens Nano Banana) — ex.: a do projeto "Agente Criativo". Usada de verdade pelo nó Prompt no Workflow Studio (/workflow); sem ela, o Prompt só loga que não tem chave e a composição segue com as imagens de Avatar/Produto.
PEXELS_API_KEY=""
PIXABAY_API_KEY=""
COVERR_API_KEY=""             # opcional: acervo de vídeo extra (grátis, cadastro em coverr.co/developers) — redundância se Pexels/Pixabay não acharem nada
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# Publicação automática no YouTube (opcional). Crie um projeto no Google Cloud Console,
# habilite a "YouTube Data API v3", configure a tela de consentimento OAuth (modo "Externo" +
# seu e-mail como usuário de teste é suficiente pra uso pessoal) e crie uma credencial OAuth
# "App para computador" (Desktop app). Cole o Client ID/Secret aqui e conecte em Settings.
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI="http://localhost:3210/api/auth/youtube/callback"

# Worker
WORKER_POLL_MS="1000"
# Quantos jobs o worker processa em paralelo (pipeline paralelo). RENDER_VIDEO sempre
# fica exclusivo (só 1 por vez) independente desse valor, por pesar em CPU/RAM (ffmpeg).
WORKER_CONCURRENCY="2"
# URL opcional chamada quando um job termina (para n8n, Telegram etc.)
WEBHOOK_URL=""

# Modelo de texto do Gemini (free tier). Troque para gemini-3.1-pro-preview para roteiros finais (pago).
GEMINI_TEXT_MODEL="gemini-3.6-flash"
TEXT_PROVIDER="GEMINI"
# Modelo de voz do Gemini (free tier)
GEMINI_TTS_MODEL="gemini-2.5-flash-preview-tts,gemini-3.1-flash-tts-preview"
GEMINI_TTS_TIMEOUT_MS="150000"
# Reservas usadas automaticamente quando o modelo principal responde 429/503
GEMINI_TEXT_FALLBACKS="gemini-3.5-flash-lite,gemini-3.7-flash,gemini-3.8-flash,gemini-3.5-flash,gemini-flash-latest"

# --- Integrações locais/VPS (Vincere Studio 2.0) ---
# HyperFrames do PC visto pela VPS através do túnel SSH reverso.
HYPERFRAMES_URL="http://[::1]:3010"
# Onde roda o HyperFrames: "vps" (padrão: serviço pm2 vincere-hf na VPS, chega pelo túnel) ou "local"
# (preview no seu PC). Lido por scripts/iniciar-vincere.ps1. Cada pessoa escolhe o seu.
HYPERFRAMES_MODO="vps"
# Pasta dos projetos do HyperFrames (usada nos pedidos de montagem).
HYPERFRAMES_PROJECTS_DIR=""
# Endereço do próprio Vincere que o worker usa para narrar com o VoiceStudio.
VINCERE_WEB_URL="http://127.0.0.1:3210"
# VoiceStudio (container na VPS). A chave fica só aqui, nunca no código.
VOICESTUDIO_URL="http://127.0.0.1:3900"
OMNIVOICE_API_KEY=""

# --- Assistente Vince ---
# LLM do assistente (padrão: a mesma do TEXT_PROVIDER). Opções: GEMINI, OLLAMA, OPENAI_COMPAT.
ASSISTENTE_PROVIDER=""
# OPENAI_COMPAT: qualquer API /v1/chat/completions (NVIDIA NIM grátis, OpenRouter :free, Groq, Hermes…)
OPENAI_COMPAT_BASE_URL="https://integrate.api.nvidia.com/v1"
OPENAI_COMPAT_API_KEY=""
OPENAI_COMPAT_MODEL="nvidia/nemotron-3-super-120b-a12b"

# Ponte de GPU do PC (scripts/pc-gpu-bridge.py): segredo longo, o MESMO nos dois lados. Sem ele a ponte não inicia.
PC_GPU_TOKEN=""
# Pastas extras que a ponte pode ler/gravar (além do projeto e da pasta temporária), separadas por ;
PC_GPU_ALLOWED_DIRS=""

# Token do botão 'Atualizar versão' (mín. 12 caracteres). Sem ele o botão fica desativado. Gere com hf-vps.sh ou à mão.
ADMIN_TOKEN=""
# Chave pública do YouTube Data API v3 (grátis) para o painel de canais em Métricas.
YOUTUBE_API_KEY=""

# --- Agente Hermes (opcional; desligado se vazio) ---
# O Vince pode comandar o Hermes para editar o projeto. Escolha UM modo:
#  a) Hermes num servidor, por SSH (a chave precisa abrir sem senha):
HERMES_SSH_HOST=""            # usuario@servidor
HERMES_SSH_PORT="22"
HERMES_SSH_KEY=""             # caminho da chave privada
HERMES_REMOTE_BIN="hermes"    # caminho do executável no servidor
HERMES_REMOTE_PROJECTS_DIR="" # pasta dos projetos HyperFrames no servidor
#  b) Hermes instalado nesta máquina (.exe/binário; .cmd/.bat não funcionam):
HERMES_BIN=""
# 1 = passa --worktree (isola as mudanças; só funciona em projeto que seja repositório Git)
HERMES_WORKTREE=""
# Pastas extras (separadas por ; no Windows, : no Mac/Linux) a colocar no PATH dos agentes
VINCERE_AGENT_PATH=""
