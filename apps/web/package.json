{
  "name": "@vincere-studio/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3210 --hostname 127.0.0.1",
    "build": "node --max-old-space-size=4096 ../../node_modules/next/dist/bin/next build",
    "start": "next start --port 3210 --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.smoke.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts"
  },
  "dependencies": {
    "@vincere-studio/core": "workspace:*",
    "@vincere-studio/db": "workspace:*",
    "@vincere-studio/ui": "workspace:*",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.23.0",
    "dotenv": "^16.4.0",
    "@xyflow/react": "^12.8.0",
    "zustand": "^5.0.0",
    "@vincere-studio/providers": "workspace:*",
    "@vincere-studio/render": "workspace:*",
    "@prisma/client": "^6.16.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
