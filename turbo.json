{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "STORAGE_DIR",
    "GEMINI_API_KEY",
    "PEXELS_API_KEY",
    "PIXABAY_API_KEY",
    "WORKER_POLL_MS",
    "WEBHOOK_URL",
    "GEMINI_TEXT_MODEL",
    "TEXT_PROVIDER",
    "GEMINI_IMAGE_API_KEY",
    "GEMINI_TEXT_FALLBACKS",
    "GEMINI_TTS_MODEL",
    "FFMPEG_PATH",
    "FFPROBE_PATH",
    "ELEVENLABS_API_KEY",
    "ELEVENLABS_MODEL",
    "GEMINI_TTS_TIMEOUT_MS",
    "VOICE_SPLIT_PAUSES",
    "VOICE_MAX_SILENCE_MS",
    "VOICE_KEEP_SILENCE_MS"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  }
}
