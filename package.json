{
  "name": "pulsestudio",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @docupulse/db generate",
    "db:push": "pnpm --filter @docupulse/db push",
    "db:seed": "pnpm --filter @docupulse/db seed",
    "db:studio": "pnpm --filter @docupulse/db studio",
    "setup": "pnpm install && pnpm db:generate && pnpm db:push && pnpm db:seed",
    "test": "turbo run test"
  },
  "devDependencies": {
    "tsx": "^4.23.13",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
